# Superseded by results/dflash2-failures.md, which keeps the evidence without the
# repeated per-thread urllib tracebacks.
results/X-*.log

# Full serve logs are ~140 KB each; results/serve-log-provenance.txt keeps the lines
# that prove what each arm loaded.
results/*-serve.log

# Model checkpoints, drafters, benchmark data, engine caches.
*.safetensors
*.index.json
sglang-cache/
__pycache__/
*.pyc

# GSM8K test split is vendored at scripts/gsm8k_test.json (338 KB) so the accuracy
# benchmark runs with no external fetch. Other copies stay ignored.
/gsm8k_test.*
